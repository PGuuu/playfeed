{
  "rewrites": [
    {
      "source": "/u/:slug",
      "destination": "/account.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?format=xml"
    },
    {
      "source": "/games.html",
      "destination": "/api/seo"
    },
    {
      "source": "/g/:id",
      "destination": "/api/share?id=:id"
    }
  ],
  "functions": {
    "api/share.js": {
      "includeFiles": "{catalog.js,share-assets.json,index.html}",
      "maxDuration": 15
    },
    "api/og.js": {
      "includeFiles": "{catalog.js,share-assets.json}",
      "maxDuration": 30
    },
    "api/account.js": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "maxDuration": 120
    },
    "api/analytics.js": {
      "maxDuration": 15
    },
    "api/seo.js": {
      "includeFiles": "catalog.js",
      "maxDuration": 15
    }
  },
  "regions": [
    "hnd1"
  ],
  "headers": [
    {
      "source": "/preload-cards/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/share-cards/v4/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "playfeed-gilt.vercel.app"
        }
      ],
      "destination": "https://fangame.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fangame.app"
        }
      ],
      "destination": "https://fangame.app/:path*",
      "permanent": true
    }
  ]
}
