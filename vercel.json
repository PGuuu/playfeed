{
  "rewrites": [
    {
      "source": "/g/:id",
      "destination": "/api/share?id=:id"
    }
  ],
  "functions": {
    "api/share.js": {
      "includeFiles": "{catalog.js,share-assets.json,index.html}",
      "maxDuration": 15
    },
    "api/og.js": {
      "includeFiles": "{catalog.js,share-assets.json}",
      "maxDuration": 30
    },
    "api/account.js": {
      "maxDuration": 60
    },
    "api/analytics.js": {
      "maxDuration": 15
    }
  },
  "regions": [
    "hnd1"
  ],
  "headers": [
    {
      "source": "/share-cards/v3/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
